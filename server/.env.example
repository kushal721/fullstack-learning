# Copy to .env and adjust. All values are optional.
PORT=3000
NODE_ENV=development
APP_VERSION=dev
# Proxies in front of the server (set 1 on Render), so the rate limit sees
# each visitor's real IP. Leave 0 when nothing sits in front of the server.
TRUST_PROXY=0
# Other websites allowed to call the API from a browser, comma separated.
# Empty: only the platform's own pages (same origin).
CORS_ORIGINS=
# Request log level: trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
# The site's public address (e.g. https://learn.example.com) for sitemap and
# link-preview URLs. Empty: taken from each request's Host header.
PUBLIC_URL=
# Requests per IP: to /api per 15 minutes, and answer checks per minute.
RATE_LIMIT_API=300
RATE_LIMIT_CHECKS=30
